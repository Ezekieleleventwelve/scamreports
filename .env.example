# Database
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Admin auth only (public sign-in disabled). Set true to enable Google login for /admin.
ENABLE_ADMIN_AUTH="false"

# Google OAuth (requires ENABLE_ADMIN_AUTH=true)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Dev admin login: ENABLE_DEV_LOGIN=true in development
ENABLE_DEV_LOGIN="false"

# Creditor payout (warnlist claims) — claimant pays amount owed; funds disbursed to creditors
CREDITOR_PAYOUT_ACCOUNT_NAME="scamreports Creditor Pool"
CREDITOR_PAYOUT_IBAN="CH00 0000 0000 0000 0000 0"
CREDITOR_PAYOUT_BIC=""
CREDITOR_PAYOUT_BANK=""
CREDITOR_PAYOUT_REFERENCE_PREFIX="SR-CLAIM"

# Site Config
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"
NEXT_PUBLIC_SITE_NAME="scamreports"

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID="ca-pub-XXXXXXXXXXXXXXXX"

# Admin Email (ONLY this address may sign in; auto-promoted to ADMIN)
ADMIN_EMAIL="admin@yourdomain.com"

# Security: trust X-Forwarded-For / CF only behind Cloudflare or Vercel
TRUST_PROXY="true"

# HMAC secret for rate-limit fingerprints (never stores plaintext IPs) — REQUIRED in prod
CLIENT_FINGERPRINT_SECRET=""

# === FORTRESS (castle) ===
# Layer 1 — put Cloudflare proxy in front of the domain (orange cloud). Enable:
#   - DDoS / Bot Fight / Super Bot Fight Mode
#   - WAF managed rules + custom rate limits
#   - Under Attack Mode when needed
# Layer 2 — require CF edge on every request (set true ONLY after CF proxy is live)
REQUIRE_CLOUDFLARE="false"
# Layer 3 — Cloudflare Zero Trust Access on /admin* and /api/admin*
#   Dashboard → Zero Trust → Access → Application covering those paths
ADMIN_REQUIRE_CF_ACCESS="false"
# Layer 4 — shared admin gate (set a long random secret; inject via browser extension
#   or CF Transform Rule as header x-scamreports-admin-gate / cookie scamreports_admin_gate)
#   Combine with a rotating personal VPN (Mullvad/IVPN) — never IP-allowlist your home IP
ADMIN_GATE_SECRET=""

# OSINT register pipeline (scripts/osint-register-scan.ts) — draft only, no auto-publish
# Free UK key: https://developer.company-information.service.gov.uk/
COMPANIES_HOUSE_API_KEY=""
# Optional: https://opencorporates.com/api_accounts/new
OPENCORPORATES_API_KEY=""
# Optional authenticated Swiss ZefixREST (if you have access)
ZEFIX_REST_USER=""
ZEFIX_REST_PASSWORD=""

# Cloudflare Turnstile (bot protection) — required in production
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Manual report review fee (shown after submit; editors confirm before asking for payment)
REPORT_REVIEW_FEE=""
REPORT_REVIEW_FEE_CURRENCY="CHF"
REPORT_PAYOUT_ACCOUNT_NAME=""
REPORT_PAYOUT_IBAN=""
REPORT_PAYOUT_BIC=""
REPORT_PAYOUT_BANK=""
REPORT_PAYOUT_REFERENCE_PREFIX="UT-REPORT"

# Bing Webmaster
NEXT_PUBLIC_BING_VERIFICATION=""

# Google Search Console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# IndexNow (Bing + Yandex instant indexing). Put the same key in public/{INDEXNOW_KEY}.txt
INDEXNOW_KEY=""

# Yandex Webmaster
NEXT_PUBLIC_YANDEX_VERIFICATION=""

# Anthropic API (for AI Draft Generator)
ANTHROPIC_API_KEY=""

# Telegram Bot (for remote article generation)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ALLOWED_CHAT_IDS=""
TELEGRAM_WEBHOOK_SECRET=""
